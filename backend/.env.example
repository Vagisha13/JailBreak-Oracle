# Jailbreak Oracle backend configuration.
# Copy to `.env` (or use `.env.local` for a machine-local override) and fill in
# real values. Never commit real keys. All variables are optional unless noted.

# --- App ---
APP_ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-secret
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=

# --- Database ---
# Dev: SQLite (keyword memory fallback). Prod: PostgreSQL + pgvector.
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./oracle.db
SYNC_DATABASE_URL=sqlite:///./oracle.db
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# --- Auth / RBAC ---
# Disable self-registration so accounts are provisioned by an admin only.
ALLOW_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# --- Agent providers (LiteLLM models; "mock" for deterministic CI) ---
ATTACKER_PROVIDER=litellm            # litellm | mock
ATTACKER_MODEL=gpt-4o-mini
EVALUATOR_PROVIDER=litellm
EVALUATOR_MODEL=gpt-4o-mini
VERIFIER_PROVIDER=litellm
VERIFIER_MODEL=gpt-4o-mini
DEFENDER_PROVIDER=litellm
DEFENDER_MODEL=gpt-4o-mini
DEFAULT_TARGET_PROVIDER=litellm
DEFAULT_TARGET_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_PROVIDER=mock              # openai | mock (mock = keyword fallback, no pgvector needed)

# --- LLM provider keys (only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM safety rails ---
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_TIMEOUT_SECONDS=60
LLM_RATE_LIMIT_PER_MINUTE=60

# --- Campaign governance ---
MAX_CAMPAIGN_COST=5.0
MAX_ATTACK_BUDGET=50
MAX_CAMPAIGN_ROUNDS=50
DEFAULT_ATTACK_BUDGET=10
DEFAULT_MAX_ROUNDS=10
DEFAULT_EXPLORATION_RATIO=0.3
CAMPAIGN_TIMEOUT_SECONDS=600
CAMPAIGN_RATE_LIMIT_PER_MINUTE=5

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Redis (queue worker + distributed rate limiting; production) ---
# Bare-metal host / Windows local dev: connect to the Docker-published port on
# the loopback interface. Use an explicit IP (127.0.0.1), not "localhost": on
# Windows, "localhost" can resolve to ::1 where a stale non-Docker Redis may
# still be listening and shadow the container.
REDIS_URL=redis://127.0.0.1:6379/0
#
# Backend/worker running INSIDE Docker (docker-compose): use the Compose service
# name over the internal network instead of the host loopback:
# REDIS_URL=redis://redis:6379/0
#
# Startup fails fast when the responding server is older than REDIS_MIN_VERSION
# so you never silently hit the wrong/old Redis instance on the same port.
REDIS_MIN_VERSION=6.0.0

# --- Response security headers (backend) ---
SECURITY_ENABLE_HEADERS=true