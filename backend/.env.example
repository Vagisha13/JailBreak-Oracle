# ==========================================================
# Jailbreak Oracle — environment template
# Copy to `.env` (in this directory) and fill in real values.
# NEVER commit `.env`. No secrets belong in this file's committed state.
# ==========================================================

# Application ---------------------------------------------------------------
# "development" or "production". Production enforces stricter validation:
#   * SECRET_KEY must be set
#   * ASYNC_DATABASE_URL must be PostgreSQL (SQLite rejected)
#   * REDIS_URL must be set (required for the campaign worker)
APP_ENV=development

# Logging depth: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Database ------------------------------------------------------------------
# Development default is SQLite in this directory.
# Production must be PostgreSQL (postgresql+asyncpg://...).
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./oracle.db
# Sync variant used by Alembic migrations. PostgreSQL: postgresql+psycopg2://...
SYNC_DATABASE_URL=sqlite:///./oracle.db

# Test suite database. Not used by the running app. If unset in CI/dev, the
# test suite provisions an isolated temporary SQLite file automatically.
TEST_DATABASE_URL=

# Security / Authentication ---------------------------------------------------
# REQUIRED in production. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development a stable-but-insecure default is used so JWTs survive restarts.
SECRET_KEY=
# JWT signing algorithm + lifetime (minutes)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM provider API keys (at least one provider you intend to use) ------------
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Agent model configuration ---------------------------------------------------
# Each agent can use a different provider ("litellm") and model.
# "mock" is a deterministic in-memory provider used for tests/CI.
ATTACKER_PROVIDER=litellm
ATTACKER_MODEL=gpt-4o-mini
EVALUATOR_PROVIDER=litellm
EVALUATOR_MODEL=gpt-4o-mini
VERIFIER_PROVIDER=litellm
VERIFIER_MODEL=gpt-4o-mini
# Default target model (per-campaign override supported)
DEFAULT_TARGET_PROVIDER=litellm
DEFAULT_TARGET_MODEL=gpt-4o-mini

# Embeddings -------------------------------------------------------------------
# "openai" for real embeddings (requires OPENAI_API_KEY), "mock" for tests.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Campaign defaults --------------------------------------------------------------
DEFAULT_MAX_ROUNDS=20
DEFAULT_ATTACK_BUDGET=50
DEFAULT_EXPLORATION_RATIO=0.3
# Hard caps enforced by request validation
MAX_CAMPAIGN_ROUNDS=500
MAX_ATTACK_BUDGET=500
# Cost / time governance (enforced by the orchestrator)
MAX_CAMPAIGN_COST=50.0
CAMPAIGN_TIMEOUT_SECONDS=3600

# Rate limiting -------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
CAMPAIGN_RATE_LIMIT_PER_MINUTE=5
LLM_RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (job queue + distributed rate limiting) ------------------------------------
# Production requires this for the durable campaign worker.
REDIS_URL=

# LLM provider resilience -----------------------------------------------------------
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

# CORS / Security --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
SECURITY_ENABLE_HEADERS=true